---
import '../styles/global.css';

const {
  title = 'Заработай с ИИ: Честный Дневник — ИИ на практике',
  description = 'Честный дневник освоения ИИ с нуля: ChatGPT, Codex, создание сайтов, практические эксперименты, ошибки и реальные результаты обучения.',
  robots,
  canonical
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f3f0e8" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <slot />
  </body>
</html>
