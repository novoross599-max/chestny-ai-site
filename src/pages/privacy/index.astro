---
import Layout from '../../layouts/Layout.astro';
import LegalPage from '../../components/LegalPage.astro';
import consent from '../../../public/legal/PD-CONSENT-2026-09-15.json';
const sections = [
  {
    "heading": "1. Общие положения",
    "paragraphs": [
      "Настоящая Политика определяет порядок обработки и защиты персональных данных пользователей сайта chestny-ai.ru.",
      "Оператором является указанное выше физическое лицо — владелец сайта.",
      "Обработка осуществляется в соответствии с Федеральным законом №152-ФЗ «О персональных данных» и иными применимыми нормативными актами РФ.",
      "Политика размещается в открытом доступе на сайте."
    ]
  },
  {
    "heading": "2. Цель и состав обработки",
    "paragraphs": [
      "Единственная действующая цель обработки: «Получение и рассмотрение обращений пользователей сайта, подготовка и направление ответов на обращения».",
      "Субъекты персональных данных — посетители сайта, направляющие обращение через форму обратной связи. Оператор не запрашивает специальные категории персональных данных.",
      "Для указанной цели обрабатываются:"
    ],
    "items": [
      "имя пользователя;",
      "адрес электронной почты;",
      "сведения, содержащиеся в тексте обращения пользователя."
    ]
  },
  {
    "heading": "3. Правовые основания и порядок обработки",
    "paragraphs": [
      "Основание обработки — согласие субъекта персональных данных и применимые положения законодательства РФ. Согласие предоставляется отдельным активным действием пользователя.",
      "С персональными данными осуществляются следующие действия: сбор, запись, систематизация, накопление, хранение, извлечение, использование, блокирование, удаление и уничтожение.",
      "Обработка может осуществляться с использованием средств автоматизации и без них.",
      "Персональные данные не предназначены для распространения или предоставления неопределённому кругу лиц. Трансграничная передача Оператором для указанной цели не осуществляется."
    ]
  },
  {
    "heading": "4. Срок обработки и прекращение",
    "paragraphs": [
      "Персональные данные обрабатываются в течение времени, необходимого для рассмотрения обращения и направления ответа.",
      "Для обращений через форму установлен срок хранения 30 дней, если иной срок не требуется законодательством РФ.",
      "Обработка прекращается при достижении цели, отзыве согласия, законном требовании о прекращении обработки или иных предусмотренных законом основаниях."
    ]
  },
  {
    "heading": "5. Защита персональных данных",
    "paragraphs": [
      "Для защиты персональных данных применяются следующие меры:"
    ],
    "items": [
      "разграничение доступа;",
      "защита учётных записей паролями;",
      "двухфакторная аутентификация учётной записи хостинга;",
      "HTTPS;",
      "отдельный почтовый ящик для обращений;",
      "парольная и антивирусная защита рабочей станции;",
      "контроль соблюдения требований к обработке персональных данных."
    ]
  },
  {
    "heading": "6. Права пользователя",
    "paragraphs": [
      "Пользователь вправе реализовывать предусмотренные законодательством права, включая получение информации об обработке, а при наличии оснований — требовать уточнения, блокирования или уничтожения данных и отзывать согласие.",
      "Адрес для обращений: privacy@chestny-ai.ru.",
      "Законные требования исполняются в порядке и сроки, предусмотренные законодательством РФ."
    ]
  },
  {
    "heading": "7. Заключительные положения",
    "paragraphs": [
      "Политика действует с момента размещения на сайте.",
      "При изменении обработки, функциональности сайта или законодательства документ актуализируется.",
      "Если появятся новые цели или способы сбора персональных данных, документы должны быть актуализированы до начала такой обработки."
    ]
  }
];
---
<Layout canonical="https://chestny-ai.ru/privacy/" title="Политика обработки персональных данных | Честный Дневник" description="Политика обработки и защиты персональных данных пользователей сайта chestny-ai.ru: цели обработки, сроки хранения и права пользователей.">
  <LegalPage title="Политика обработки персональных данных" purpose="Порядок обработки и защиты персональных данных пользователей сайта chestny-ai.ru." sections={sections} operator={consent.operator} revision={consent.revisionLabel} />
</Layout>
