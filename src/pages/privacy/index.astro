---
import Layout from '../../layouts/Layout.astro';
import LegalPage from '../../components/LegalPage.astro';

const sections = [
  { heading: '1. Общие положения', text: 'Раздел для описания сферы действия политики, применимых терминов и принципов обработки персональных данных.', todo: '[ПРАВОВЫЕ ОСНОВАНИЯ И ПРИМЕНИМЫЕ НОРМЫ — УТОЧНИТЬ С ЮРИСТОМ]' },
  { heading: '2. Цели, категории данных и субъекты', text: 'Здесь должна появиться таблица целей обработки, категорий пользователей и минимально необходимых данных после утверждения состава реально работающих форм.', todo: '[СОСТАВ ПЕРСОНАЛЬНЫХ ДАННЫХ И СРОКИ ОБРАБОТКИ ПО КАЖДОЙ ЦЕЛИ — ЗАПОЛНИТЬ]' },
  { heading: '3. Порядок и условия обработки', text: 'Раздел для описания способов сбора, хранения, защиты, прекращения обработки и удаления данных.', todo: '[РОССИЙСКИЙ ОБРАБОТЧИК, МЕСТО ХРАНЕНИЯ, МЕРЫ ЗАЩИТЫ И ПОРЯДОК УДАЛЕНИЯ — ЗАПОЛНИТЬ]' },
  { heading: '4. Права пользователя и обращения', text: 'Здесь необходимо описать порядок отзыва согласия, уточнения, блокирования и удаления персональных данных.', todo: '[КАНАЛ И СРОКИ РАССМОТРЕНИЯ ОБРАЩЕНИЙ — ЗАПОЛНИТЬ]' },
  { heading: '5. Передача третьим лицам и использование файлов cookie', text: 'Раздел заполняется только по фактической архитектуре сайта и подключённым сервисам.', todo: '[ПЕРЕЧЕНЬ ПОЛУЧАТЕЛЕЙ, ПОРУЧЕНИЙ ОБРАБОТКИ, COOKIE И СЧЁТЧИКОВ — ЗАПОЛНИТЬ ИЛИ УКАЗАТЬ ИХ ОТСУТСТВИЕ]' }
];
---
<Layout title="Политика обработки персональных данных — Честный Дневник" description="Техническая заготовка политики обработки персональных данных проекта.">
  <LegalPage title="Политика обработки персональных данных" purpose="зафиксировать правила обработки и защиты персональных данных после утверждения оператора и технической архитектуры." sections={sections} />
</Layout>
