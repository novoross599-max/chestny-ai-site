---
import Layout from '../../layouts/Layout.astro';
import LegalPage from '../../components/LegalPage.astro';

const sections = [
  { heading: '1. Цель будущей обработки', text: 'Направление информационных сообщений и уведомлений об обновлениях проекта «Заработай с ИИ: Честный Дневник».' },
  { heading: '2. Предполагаемый канал и состав данных', text: 'Email, который пользователь самостоятельно укажет в отдельной форме подписки.', todo: '[АДРЕС ОТПРАВИТЕЛЯ, РОССИЙСКИЙ СЕРВИС РАССЫЛКИ И ПЕРИОДИЧНОСТЬ СООБЩЕНИЙ — ЗАПОЛНИТЬ]' },
  { heading: '3. Условия получения сообщений', text: 'Согласие на информационные сообщения должно даваться отдельно от согласия для формы обратной связи и фиксироваться только после подключения законного технического решения.', todo: '[СПОСОБ ФИКСАЦИИ СОГЛАСИЯ, СРОК ЕГО ДЕЙСТВИЯ И СОСТАВ ДЕЙСТВИЙ С EMAIL — ЗАПОЛНИТЬ]' },
  { heading: '4. Отказ от сообщений', text: 'В готовом документе необходимо описать простой и доступный способ прекратить рассылку.', todo: '[МЕХАНИЗМ ОТПИСКИ И КОНТАКТ ДЛЯ ОТЗЫВА СОГЛАСИЯ — ЗАПОЛНИТЬ]' }
];
---
<Layout title="Согласие на получение информационных сообщений — Честный Дневник" description="Техническая заготовка отдельного согласия для будущей подписки.">
  <LegalPage title="Согласие на получение информационных сообщений" purpose="оформить отдельное согласие пользователя на будущие уведомления об обновлениях проекта." sections={sections} />
</Layout>
