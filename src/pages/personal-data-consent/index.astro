---
import Layout from '../../layouts/Layout.astro';
import LegalPage from '../../components/LegalPage.astro';

const sections = [
  { heading: '1. Цель будущей обработки', text: 'Обработка обращения пользователя и предоставление ответа на него.' },
  { heading: '2. Предполагаемый состав данных', text: 'Имя, указанный пользователем Email или Telegram, а также содержание сообщения.', todo: '[ПРОВЕРИТЬ СОСТАВ ДАННЫХ ПОСЛЕ ПОДКЛЮЧЕНИЯ РЕАЛЬНОЙ ФОРМЫ]' },
  { heading: '3. Действия с персональными данными', text: 'Перечень действий должен соответствовать фактической работе будущего российского решения обработки и хранения.', todo: '[ПЕРЕЧЕНЬ ДЕЙСТВИЙ, СПОСОБ ОБРАБОТКИ, СРОК ХРАНЕНИЯ И УСЛОВИЯ УДАЛЕНИЯ — ЗАПОЛНИТЬ]' },
  { heading: '4. Отзыв согласия', text: 'Порядок отзыва необходимо определить после указания оператора и рабочего контакта для обращений.', todo: '[СПОСОБ ОТЗЫВА СОГЛАСИЯ И СРОК ПРЕКРАЩЕНИЯ ОБРАБОТКИ — ЗАПОЛНИТЬ]' }
];
---
<Layout title="Согласие на обработку персональных данных — Честный Дневник" description="Техническая заготовка согласия для будущей формы обращения.">
  <LegalPage title="Согласие на обработку персональных данных" purpose="оформить отдельное согласие пользователя для будущей обработки обращения и ответа на него." sections={sections} />
</Layout>
