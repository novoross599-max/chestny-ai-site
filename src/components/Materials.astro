---
const items = [['Промпты','Рабочие формулировки для понятного диалога с ИИ.'],['Инструкции','Пошаговые разборы без пропущенных действий.'],['Мини-гайды','Короткие памятки для решения одной конкретной задачи.']];
---
<section class="section materials" id="materials"><div class="container material-box"><div class="material-intro"><span class="section-label">Полезные материалы</span><h2 class="section-title">Библиотека практических находок</h2><p>Этот раздел будет расти вместе с дневником. Здесь появится всё, что хочется сохранить под рукой и повторить самостоятельно.</p><span class="soon">Скоро первые материалы</span></div><div class="material-list">{items.map(([title,text],i) => <article><span>{String(i+1).padStart(2,'0')}</span><div><h3>{title}</h3><p>{text}</p></div><b>в работе</b></article>)}</div></div></section>
<style>
  .materials { background: var(--surface); } .material-box { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2rem,7vw,7rem); padding: clamp(1.5rem,5vw,4rem); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface-strong); box-shadow: var(--shadow); } .soon { display: inline-block; margin-top: 1rem; padding: .45rem .7rem; border: 1px solid var(--primary); border-radius: 99px; color: var(--primary); background: transparent; font-size: .7rem; font-weight: 800; text-transform: uppercase; } .material-list { align-self: center; } article { display: grid; grid-template-columns: 45px 1fr auto; gap: 1rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line); } article:first-child { border-top: 1px solid var(--line); } article > span { color: var(--primary); font-family: var(--font-heading); } h3,p { margin-bottom: .25rem; } article p { font-size: .95rem; } article b { align-self: center; color: var(--muted); font-size: .65rem; text-transform: uppercase; } @media(max-width:760px){.material-box{grid-template-columns:1fr}article{grid-template-columns:35px 1fr}article b{display:none}}
</style>
