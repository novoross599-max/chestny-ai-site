---
const steps = [['Идея','Формулирую небольшую задачу с понятным результатом.'],['Изучение','Нахожу ровно те знания, которые нужны для следующего шага.'],['Практика','Собираю рабочий вариант и разбираюсь в процессе.'],['Проверка','Запускаю, тестирую и исправляю то, что не сработало.'],['Выводы','Записываю результат простым языком и делюсь находками.']];
---
<section class="section" id="process"><div class="container"><span class="section-label">Как проходит обучение</span><h2 class="section-title">Понятный цикл вместо бесконечной подготовки</h2><p class="section-lead">Каждый новый навык проходит один и тот же маршрут. Так знания сразу превращаются в опыт.</p><ol>{steps.map(([title,text],i) => <li><span>0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div></section>
<style>
  ol { display: grid; grid-template-columns: repeat(5,1fr); margin: 3.5rem 0 0; padding: 0; list-style: none; counter-reset: step; } li { position: relative; padding: 0 1.2rem; border-left: 1px solid var(--line); } li:first-child { padding-left: 0; border: 0; } li::before { content: ''; position: absolute; top: 20px; left: 0; right: 0; height: 1px; background: var(--line); z-index: -1; } li > span { display: grid; place-items: center; width: 42px; height: 42px; margin-bottom: 2.2rem; border: 1px solid var(--line); border-radius: 50%; color: var(--primary); background: var(--bg); font-size: .72rem; font-weight: 800; } li:last-child > span { color: white; background: var(--primary); } li p { font-size: .85rem; } @media(max-width:850px){ol{grid-template-columns:1fr 1fr;gap:2.5rem 0}li{border-left:0}li::before{display:none}} @media(max-width:520px){ol{grid-template-columns:1fr}li,li:first-child{display:grid;grid-template-columns:52px 1fr;gap:1rem;padding:0}li>span{margin:0}}
</style>
