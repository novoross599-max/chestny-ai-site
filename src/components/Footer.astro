---
const links = [['О проекте','#about'],['Что изучаю','#topics'],['Результаты','#results'],['Материалы','#materials'],['FAQ','#faq'],['Связаться','#contact']];
const legalLinks = [
  ['Политика обработки персональных данных', '/privacy/'],
  ['Согласие на обработку персональных данных', '/personal-data-consent/'],
  ['Согласие на получение информационных сообщений', '/newsletter-consent/']
];
---
<footer><div class="container"><div class="footer-top"><a class="footer-brand" href="/#top">Заработай с ИИ<small>Честный Дневник</small></a><nav aria-label="Навигация в подвале">{links.map(([label,href]) => <a href={`/${href}`}>{label}</a>)}</nav></div><section class="legal-links" aria-labelledby="legal-title"><h2 id="legal-title">Правовая информация</h2><div>{legalLinks.map(([label,href]) => <a href={href}>{label}</a>)}</div></section><div class="footer-bottom"><p>Сайт отражает личный опыт обучения и не является обещанием финансового результата.</p><span>© 2026 Честный Дневник</span></div></div></footer>
<style>
  footer { padding: 3rem 0 2rem; color: white; background: var(--primary); } .footer-top,.footer-bottom { display: flex; justify-content: space-between; gap: 2rem; } .footer-top { align-items: start; padding-bottom: 2rem; } .footer-brand { font-size: 1.1rem; font-weight: 700; line-height: 1.2; text-decoration: none; } .footer-brand small { display: block; margin-top: .3rem; color: white; font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; } nav { display: flex; flex-wrap: wrap; justify-content: end; gap: .8rem 1.6rem; } nav a { color: white; font-size: .82rem; text-decoration: none; } .legal-links { padding: 1.35rem 0; border-top: 1px solid rgba(255,255,255,.35); } .legal-links h2 { margin-bottom: .7rem; color: white; font-family: var(--font-body); font-size: .8rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; } .legal-links div { display: flex; flex-wrap: wrap; gap: .65rem 1.5rem; } .legal-links a { color: white; font-size: .78rem; text-decoration-thickness: 1px; text-underline-offset: 3px; } .footer-bottom { padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,.35); color: white; font-size: .78rem; } .footer-bottom p { max-width: 600px; margin: 0; color: inherit; } @media(max-width:650px){.footer-top,.footer-bottom{flex-direction:column}nav{justify-content:start}.footer-top{padding-bottom:2rem}.legal-links div{align-items:flex-start;flex-direction:column}}
</style>
