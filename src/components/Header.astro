---
const links = [
  ['О проекте', '#about'], ['Что изучаю', '#topics'], ['Результаты', '#results'], ['Материалы', '#materials'], ['FAQ', '#faq']
];
---
<header class="header">
  <div class="container nav-wrap">
    <a class="brand" href="#top" aria-label="На главную">
      <img class="author-photo" src="/images/author.jpg" alt="Автор проекта" width="42" height="42" />
      <span>Заработай с ИИ<small>Честный Дневник</small></span>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav"><span></span><span></span><span></span><b>Меню</b></button>
    <nav id="site-nav" aria-label="Основная навигация">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
      <a class="btn btn-primary" href="https://t.me/AI_Dnevnik_K" target="_blank" rel="noopener noreferrer">Читать дневник</a>
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector('.menu-btn');
  const nav = document.querySelector('#site-nav');
  button?.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('open', !open); });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { button?.setAttribute('aria-expanded', 'false'); nav.classList.remove('open'); }));
</script>
<style>
  .header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid rgba(217,216,207,.8); background: rgba(243,240,232,.88); backdrop-filter: blur(16px); }
  .nav-wrap { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .brand { display: flex; flex: 0 0 auto; align-items: center; gap: .72rem; font-size: .9rem; font-weight: 700; line-height: 1.1; text-decoration: none; }
  .author-photo { display: block; flex: 0 0 42px; width: 42px; height: 42px; border: 2px solid var(--primary); border-radius: 50%; background: var(--surface-strong); object-fit: cover; object-position: 50% 42%; }
  .brand small { display: block; margin-top: .25rem; color: var(--muted); font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; }
  nav { display: flex; align-items: center; gap: clamp(.7rem, 1.45vw, 1.25rem); }
  nav > a:not(.btn) { font-size: .82rem; font-weight: 700; text-decoration: none; }
  nav > a:not(.btn):hover { color: var(--primary); }
  nav .btn { min-height: 42px; padding: .65rem 1rem; }
  .menu-btn { display: none; border: 0; background: none; }
  @media (max-width: 980px) {
    .menu-btn { display: grid; width: 44px; height: 44px; place-content: center; gap: 4px; border: 1px solid var(--line); border-radius: 50%; cursor: pointer; }
    .menu-btn span { width: 18px; height: 2px; background: var(--ink); } .menu-btn b { position: absolute; width: 1px; height: 1px; overflow: hidden; }
    nav { position: absolute; left: 1rem; right: 1rem; top: 68px; display: none; align-items: stretch; flex-direction: column; padding: 1rem; border: 1px solid var(--line); border-radius: 18px; background: var(--surface-strong); box-shadow: var(--shadow); }
    nav.open { display: flex; } nav > a:not(.btn) { padding: .55rem; }
  }
</style>
